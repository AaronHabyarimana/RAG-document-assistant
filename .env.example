# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Secrets ---------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Infrastructure --------------------------------------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# --- Chunking (varied during phase 5 ablations) ----------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# --- Embedding -------------------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Retrieval -------------------------------------------------------------
RETRIEVAL_TOP_K=5
RERANK_CANDIDATES=20

# --- Generation ------------------------------------------------------------
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=4096
